{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Pages éditoriales WeSoft construites avec une zone dynamique"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "pageType": {
      "type": "enumeration",
      "enum": [
        "standard",
        "home",
        "solutions",
        "about",
        "newsIndex",
        "article",
        "contact",
        "legal"
      ],
      "default": "standard",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "publishedDate": {
      "type": "date"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "sections.hero",
        "sections.feature-grid",
        "sections.process",
        "sections.business-characteristics",
        "sections.metrics",
        "sections.cta",
        "sections.article-list",
        "sections.form-section",
        "sections.rich-text",
        "sections.software-showcase",
        "sections.testimonial-metrics",
        "sections.team",
        "sections.contact",
        "sections.legal-content"
      ]
    }
  }
}
